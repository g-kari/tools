{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended", "helpers:pinGitHubActionDigests"],
  "automerge": true,
  "automergeType": "pr",
  "platformAutomerge": true,
  "ignoreTests": false,
  "ignoreScripts": true,
  "rebaseWhen": "behind-base-branch",
  "minimumReleaseAge": "14 days",
  "minimumReleaseAgeBehaviour": "timestamp-required",
  "internalChecksFilter": "strict",
  "packageRules": [
    {
      "description": "Keep every dependency review-first unless explicitly allowed below.",
      "matchPackageNames": ["*"],
      "automerge": true
    },
    {
      "description": "Keep these updates manual until required real CI checks are enforced and verified.",
      "matchManagers": ["github-actions"],
      "matchPackageNames": ["actions/checkout", "actions/setup-node", "actions/upload-artifact"],
      "matchFileNames": [
        ".github/workflows/catalog-search-browser.yml",
        ".github/workflows/clipboard-browser.yml",
        ".github/workflows/csv-json-browser.yml",
        ".github/workflows/emoji-gif-browser.yml",
        ".github/workflows/grapheme-browser.yml",
        ".github/workflows/hash-browser.yml",
        ".github/workflows/json-browser.yml",
        ".github/workflows/json-flatten-browser.yml",
        ".github/workflows/json-lines-browser.yml",
        ".github/workflows/json-pointer-browser.yml",
        ".github/workflows/markdown-preview-browser.yml"
      ],
      "matchUpdateTypes": ["minor", "patch", "digest", "pinDigest"],
      "minimumReleaseAge": "14 days",
      "minimumReleaseAgeBehaviour": "timestamp-required",
      "internalChecksFilter": "strict",
      "ignoreTests": false,
      "automerge": false,
      "automergeType": "pr",
      "platformAutomerge": false,
      "ignoreScripts": true,
      "rebaseWhen": "behind-base-branch"
    },
    {
      "description": "Review pre-1.0 dependency changes explicitly.",
      "matchCurrentVersion": "/^v?0\\./",
      "automerge": false
    },
    {
      "description": "Fail closed: keep every dependency manual until required real CI checks are enforced and verified.",
      "matchPackageNames": ["*"],
      "automerge": true
    },
    {
      "matchUpdateTypes": ["minor", "patch"],
      "matchCurrentVersion": "!/^0/",
      "automerge": true
    }
  ],
  "vulnerabilityAlerts": {
    "enabled": true,
    "minimumReleaseAge": null,
    "automerge": false
  },
  "lockFileMaintenance": {
    "enabled": false,
    "automerge": false
  }
}
